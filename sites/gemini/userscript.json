{
  "id": "ggpp",
  "name": "GG++",
  "namespace": "ggpp",
  "description": "A plugin-first mod for Gemini on the web (Userscript++).",
  "author": "GG++",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "icon": "data:image/svg+xml;base64,",
  "fileName": "GGPP",
  "global": "GGPP",
  "globalInProduction": true,
  "match": [
    "https://gemini.google.com/*"
  ],
  "connect": [
    "raw.githubusercontent.com",
    "gist.githubusercontent.com",
    "cdn.jsdelivr.net",
    "*.github.io",
    "*"
  ],
  "themeHosts": [
    "raw.githubusercontent.com",
    "cdn.jsdelivr.net",
    "*.github.io"
  ],
  "grants": [
    "GM.getValue",
    "GM.setValue",
    "GM.deleteValue",
    "GM.listValues",
    "GM.xmlHttpRequest",
    "GM.notification",
    "GM.registerMenuCommand"
  ]
}
